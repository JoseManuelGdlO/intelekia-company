PORT=3000
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
AGENT_INTERVAL_HOURS=6

# Base de datos que los agentes pueden consultar (SOLO LECTURA).
# Usa un usuario MySQL con permisos SELECT únicamente, nunca root.
DB_HOST=
DB_PORT=3306
DB_NAME=admin-intelekia
DB_USER=agente_seguimiento
DB_PASSWORD=
# Tablas que los agentes pueden leer y columnas que nunca pueden ver (separadas por coma).
DB_ALLOWED_TABLES=Projects,Tasks,BoardColumns,TaskActivities,Notes,ProjectMembers,Users,FinanceItems
DB_BLOCKED_COLUMNS=passwordHash,email

# Correo saliente para los agentes (SMTP). Hostinger: smtp.hostinger.com, puerto 465 (SSL).
# Recomendado: un buzón dedicado, p. ej. pm@intelekia.cloud.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=direccion@intelekia.cloud
SMTP_PASSWORD="DelsyFelix2.1"
SMTP_FROM_NAME=PM · Intelekia
# A dónde llegan las respuestas (opcional, p. ej. tu correo).
SMTP_REPLY_TO=
# Copia oculta (CCO) de cada correo que envíen los agentes, para tener registro en tu buzón (opcional).
SMTP_BCC=josemanuelgarciadelao@gmail.com
# Texto al final de cada correo (déjalo vacío para no agregar firma).
SMTP_FIRMA=Enviado por el PM, asistente de IA de Intelekia Consultoría.


# Revisor de PRs (plugin MCP de GitHub). Token personal con permisos de Pull requests (lectura y
# escritura), Contents (lectura y escritura, necesario para el merge) y Metadata (lectura).
GITHUB_TOKEN=
# Cuenta cuyos repositorios se vigilan. Los PRs que abra esta misma cuenta se ignoran.
GITHUB_OWNER=

# Respuestas en Redes (Graph API de Meta). Token de PÁGINA de larga duración con permisos
# pages_show_list, pages_read_engagement, pages_read_user_content, pages_manage_engagement,
# instagram_basic e instagram_manage_comments. Deja vacío META_IG_USER_ID o META_PAGE_ID para usar solo una red.
META_PAGE_TOKEN=
META_PAGE_ID=
META_IG_USER_ID=
META_API_VERSION=v21.0

# Canal de WhatsApp (Cloud API de Meta). Token permanente de usuario del sistema con
# whatsapp_business_messaging y whatsapp_business_management. El webhook es
# https://<tu-dominio-ngrok>/webhook/whatsapp con el verify token de abajo.
# El webhook escucha en su PROPIO puerto (solo atiende /webhook/whatsapp).
# ngrok debe apuntar a ESTE puerto, nunca al 3000 (el de la oficina): ngrok http 3100
WHATSAPP_WEBHOOK_PORT=3100
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Números que pueden usar el canal, separados por coma, solo dígitos con lada (México: 52 + 10 dígitos;
# también se acepta 521 + 10 dígitos, se normaliza solo).
WHATSAPP_PERMITIDOS=
# Opcional: plantilla aprobada con un parámetro (número de pendientes) para avisar fuera de la ventana de 24 h.
WHATSAPP_PLANTILLA_AVISO=
WHATSAPP_PLANTILLA_IDIOMA=es_MX
WHATSAPP_API_VERSION=v21.0
WHATSAPP_VOZ=alloy
